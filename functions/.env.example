# ============================================================
# VISION BACKEND — Environment Variables
# ============================================================
# Copy this file to .env and fill in your values.
# NEVER commit .env to Git. This file (.env.example) is safe.
# ============================================================

# ── App ──────────────────────────────────────────────────────
NODE_ENV=development          # development | production
LOG_LEVEL=info                # debug | info | warn | error

# ── WhatsApp Provider ────────────────────────────────────────
# Choose your provider: ultramsg | twilio | waapi
WHATSAPP_PROVIDER=ultramsg

# Ultramsg (recommended for Gulf region)
# Get these from: https://app.ultramsg.com
WHATSAPP_INSTANCE_ID=instance12345
WHATSAPP_TOKEN=your_ultramsg_token_here
WHATSAPP_API_URL=https://api.ultramsg.com

# Twilio (if using Twilio WhatsApp)
# WHATSAPP_TOKEN=ACxxxxxxxxxx:your_auth_token   (format: AccountSid:AuthToken)
# WHATSAPP_FROM_NUMBER=+14155238886

# WaAPI
# WHATSAPP_API_URL=https://waapi.app
# WHATSAPP_INSTANCE_ID=your_instance_id
# WHATSAPP_TOKEN=your_waapi_token

# ── Nazmly Webhook Security ───────────────────────────────────
# Set this in your Nazmly dashboard under Webhooks > Secret
NAZMLY_WEBHOOK_SECRET=your_nazmly_webhook_secret_here
NAZMLY_VERIFY_SIGNATURE=true   # Set to false during local testing

# ── Business Rules ────────────────────────────────────────────
CART_ABANDONMENT_HOURS=1       # Hours before sending abandonment message
FEEDBACK_DELAY_DAYS=2          # Days after purchase to send feedback

# ── Product ───────────────────────────────────────────────────
PRODUCT_NAME=Vision
COMMUNITY_INVITE_LINK=https://chat.whatsapp.com/EakoWrfFC8n9SIDMkAETRm

# ── Vision WhatsApp Sender ────────────────────────────────────
# WhatsApp Business number: +201037263073
# Connect it via Ultramsg: https://app.ultramsg.com
